<tr><td class="city"><a class="cell-link" href="#pcs-berkeley">Berkeley, CA</a><span class="place">flagship</span></td><td>Repeal of single-family-only zoning</td><td class="year">2021–24</td><td><span class="pill emerging">In progress</span></td></tr>
<tr><td class="city"><a class="cell-link" href="#pcs-cincinnati">Cincinnati, OH</a><span class="place">flagship</span></td><td>Connected Communities — transit-corridor density</td><td class="year">2024</td><td><span class="pill durable">Durable</span></td></tr>
<tr><td class="city"><a class="cell-link" href="#pcs-columbus">Columbus, OH</a><span class="place">flagship</span></td><td>"Zone In" citywide code rewrite</td><td class="year">2024–</td><td><span class="pill emerging">In progress</span></td></tr>
<tr><td class="city"><a class="cell-link" href="#pcs-gainesville">Gainesville, FL</a><span class="place">watch</span></td><td>SF-zoning repeal, then reversed</td><td class="year">2022 → 2023</td><td><span class="pill watch">Rolled back</span></td></tr>
