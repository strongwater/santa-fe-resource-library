<tr><td class="city"><a class="cell-link" href="#pcs-bend">Bend, OR</a><span class="place">peer</span></td><td>Climate Friendly Areas + middle housing</td><td class="year">2023–</td><td><span class="pill durable">Durable</span></td></tr>
<tr><td class="city"><a class="cell-link" href="#pcs-flagstaff">Flagstaff, AZ</a><span class="place">peer</span></td><td>Citywide middle-housing code (state-mandated)</td><td class="year">2024–25</td><td><span class="pill durable">Durable</span></td></tr>
