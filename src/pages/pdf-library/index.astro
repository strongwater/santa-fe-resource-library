<script>
  const input = document.getElementById('pdf-filter-input');
  if (input) {
    const groups = Array.from(document.querySelectorAll('.link-group'));
    const nav = document.querySelector('nav.jump');
    const clearBtn = document.getElementById('pdf-filter-clear');
    const countEl = document.getElementById('pdf-filter-count');
    const emptyEl = document.getElementById('pdf-filter-empty');

    function applyFilter() {
      const q = input.value.trim().toLowerCase();
      let totalVisible = 0;
      groups.forEach((group) => {
        const rows = Array.from(group.querySelectorAll('.link-row'));
        let visibleInGroup = 0;
        rows.forEach((row) => {
          const match = !q || row.textContent.toLowerCase().indexOf(q) !== -1;
          row.style.display = match ? '' : 'none';
          if (match) visibleInGroup++;
        });
        group.style.display = visibleInGroup ? '' : 'none';
        totalVisible += visibleInGroup;
      });
      if (nav) nav.style.display = q ? 'none' : '';
      clearBtn.hidden = !q;
      countEl.textContent = q ? (totalVisible + (totalVisible === 1 ? ' result' : ' results')) : '';
      emptyEl.hidden = !(q && totalVisible === 0);
    }

    input.addEventListener('input', applyFilter);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && input.value) {
        input.value = '';
        applyFilter();
      }
    });
    clearBtn.addEventListener('click', () => {
      input.value = '';
      applyFilter();
      input.focus();
    });
  }
</script>
