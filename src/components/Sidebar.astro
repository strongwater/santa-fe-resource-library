---
// Primary site navigation. Real <a href> links replace the old
// data-target SPA router entirely — see MIGRATION_GUIDE.md.
const path = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href);
}

type Section = { href: string; label: string };
type Link = { href: string; label: string; tag?: string; sections?: Section[] };

const navGroups: { label?: string; links: Link[] }[] = [
  { links: [{ href: '/', label: 'Overview' }] },
  {
    links: [
      {
        href: '/recommendations/',
        label: 'Recommendations',
        tag: '5 areas',
        sections: [
          { href: '#rec-scan', label: 'General Plan Reforms' },
          { href: '#rec-guide', label: 'Plan Language' },
          { href: '#rec-incentives', label: 'Housing Incentives' },
          { href: '#rec-ldc', label: 'Land Development Code' },
          { href: '#rec-historic', label: 'Historic Preservation' },
        ],
      },
    ],
  },
  {
    label: 'Local & State Context',
    links: [
      {
        href: '/local/santa-fe-today/',
        label: 'Where the Updates Stand',
        tag: 'Status',
        sections: [
          { href: '#status-gp', label: 'General Plan Update' },
          { href: '#status-ldc', label: 'Land Development Code' },
          { href: '#status-drm', label: 'Development Review' },
        ],
      },
      {
        href: '/local/nm-housing-policy/',
        label: 'New Mexico & Local Housing Policy',
        tag: '4 sources',
        sections: [
          { href: '#nmhp-state', label: 'NM Housing Strategy' },
          { href: '#nmhp-city', label: "Santa Fe's Own Plan" },
          { href: '#nmhp-county', label: "Santa Fe County's Plan" },
          { href: '#nmhp-permitting', label: 'Permitting Reform (independent)' },
        ],
      },
    ],
  },
  {
    label: 'Comparative Research',
    links: [
      {
        href: '/research/general-plan-reforms/',
        label: 'Effective General Plan Reforms',
        tag: '20 cities',
        sections: [
          { href: '#glance', label: 'At a glance' },
          { href: '#flagship', label: 'Flagship reforms' },
          { href: '#cautionary', label: 'Reform durability' },
          { href: '#peer', label: 'Peer-scale cities' },
          { href: '#pcs-minneapolis', label: 'Minneapolis, Minnesota' },
          { href: '#pcs-portland', label: 'Portland, Oregon' },
          { href: '#pcs-sacramento', label: 'Sacramento, California' },
          { href: '#pcs-charlotte', label: 'Charlotte, North Carolina' },
          { href: '#pcs-austin', label: 'Austin, Texas' },
          { href: '#pcs-berkeley', label: 'Berkeley, California' },
          { href: '#pcs-cincinnati', label: 'Cincinnati, Ohio' },
          { href: '#pcs-columbus', label: 'Columbus, Ohio' },
          { href: '#pcs-gainesville', label: 'Gainesville, Florida' },
          { href: '#pcs-arlington', label: 'Arlington County, Virginia' },
          { href: '#pcs-alexandria', label: 'Alexandria, Virginia' },
          { href: '#pcs-boulder', label: 'Boulder, Colorado' },
          { href: '#pcs-missoula', label: 'Missoula, Montana' },
          { href: '#pcs-bend', label: 'Bend, Oregon' },
          { href: '#pcs-flagstaff', label: 'Flagstaff, Arizona' },
          { href: '#pcs-spokane', label: 'Spokane, Washington' },
          { href: '#pcs-tacoma', label: 'Tacoma, Washington' },
          { href: '#pcs-southbend', label: 'South Bend, Indiana' },
          { href: '#pcs-santabarbara', label: 'Santa Barbara, California' },
          { href: '#pcs-somerville', label: 'Somerville, Massachusetts' },
        ],
      },
      {
        href: '/research/plan-language/',
        label: 'General Plan Language Comparisons',
        tag: '20 plans',
        sections: [
          { href: '#g-context', label: 'The opportunity' },
          { href: '#g-plans', label: 'The twenty plans' },
        ],
      },
      {
        href: '/research/housing-incentives/',
        label: 'Affordable Housing Incentives',
        tag: '11 programs',
        sections: [
          { href: '#ahi-state', label: 'State programs' },
          { href: '#ahi-city', label: 'City programs' },
        ],
      },
      { href: '/research/ldc-concepts/', label: 'Land Development Code Concepts', tag: '7 concepts' },
      {
        href: '/research/historic-preservation/',
        label: 'Historic Preservation Approaches',
        tag: '8 cities',
        sections: [
          { href: '#hp-findings', label: "Santa Fe's own findings" },
          { href: '#hp-survey-group', label: 'Survey & documentation' },
          { href: '#hp-tiers-group', label: 'Protection tiers & authority' },
          { href: '#hp-displacement-group', label: 'Preservation & displacement' },
          { href: '#hp-community-group', label: 'Community voice' },
          { href: '#hp-standards-group', label: 'SHPO / CLG standards' },
        ],
      },
    ],
