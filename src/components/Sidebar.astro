          { href: '#pdf-1999gp', label: '1999 General Plan' },
          { href: '#pdf-forward', label: 'GP Update' },
          { href: '#pdf-assessment', label: 'Assessment Report & Vision' },
          { href: '#pdf-nmhousing', label: 'NM & Local Housing Policy' },
          { href: '#pdf-streets', label: 'Streets & Transportation' },
          { href: '#pdf-peerplans', label: 'Peer Comprehensive Plans' },
          { href: '#pdf-ahistate', label: 'Incentives — State' },
          { href: '#pdf-ahicity', label: 'Incentives — City' },
          { href: '#pdf-historic', label: 'Historic Preservation' },
          { href: '#pdf-supporting', label: 'Supporting Docs' },
        ],
      },
    ],
  },
];
---
<nav class="sidebar" id="sidebar" aria-label="Resource library navigation">
  <a class="brand" href="/">
    <span class="mark">GP &amp; LDC Update</span>
    <h1>Santa Fe Urban Planning Resource Library</h1>
  </a>

  {navGroups.map((group) => (
    <div class="nav-group">
      {group.label && <div class="nav-label">{group.label}</div>}
      {group.links.map((link) => {
        const active = isActive(link.href);
        const sections = link.sections ?? [];
        const hasSections = sections.length > 0;
        return (
          <div class="nav-item">
            <div class="nav-row">
              {hasSections ? (
                <button
                  class="nav-caret"
                  type="button"
                  aria-expanded={active ? 'true' : 'false'}
                  aria-label={`Toggle sections for ${link.label}`}
                >
                  <svg viewBox="0 0 16 16" width="10" height="10" aria-hidden="true">
                    <path d="M4 2 L12 8 L4 14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>
              ) : (
                <span class="nav-caret-spacer" aria-hidden="true"></span>
              )}
              <a
                class:list={['nav-link', { active }]}
                href={link.href}
                aria-current={active ? 'page' : undefined}
              >
                {link.label}
              </a>
            </div>
            {hasSections && (
              <div class="nav-sections" data-open={active ? 'true' : 'false'}>
                {sections.map((s) => (
                  <a class="nav-sublink" href={`${link.href}${s.href}`}>{s.label}</a>
                ))}
              </div>
            )}
          </div>
        );
      })}
    </div>
  ))}

  <div class="sidebar-foot">
    Compiled Aug 2026<br>
    First-pass working library
  </div>
</nav>
